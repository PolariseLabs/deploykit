  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@deploykit/core": "workspace:*",
    "@effect/platform-node": "4.0.0-rc.112",
    "@noble/hashes": "^2.4.0",
    "effect": "4.0.0-rc.112"
  }
}
