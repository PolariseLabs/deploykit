{
  "name": "@deploykit/cloudflare",
  "version": "1.0.0",
  "description": "Cloudflare Pages adapter for deploykit.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
