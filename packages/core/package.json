{
  "name": "@deploykit/core",
  "version": "0.1.0-alpha.1",
  "description": "Provider-independent deployment domain: Artifact, App, Deployment, errors, capabilities.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "default": "./dist/provider/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    },
    "./artifact": {
      "types": "./dist/artifact/index.d.ts",
      "default": "./dist/artifact/index.js"
    },
    "./entry": {
      "types": "./dist/artifact/entry.d.ts",
      "default": "./dist/artifact/entry.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "default": "./dist/source.js"
    },
    "./transfer": {
      "types": "./dist/transfer.d.ts",
      "default": "./dist/transfer.js"
    },
    "./http": {
      "types": "./dist/provider/http.d.ts",
      "default": "./dist/provider/http.js"
    },
    "./staging": {
      "types": "./dist/staging.d.ts",
      "default": "./dist/staging.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    },
    "./manifest-builder": {
      "types": "./dist/manifestBuilder.d.ts",
      "default": "./dist/manifestBuilder.js"
    },
    "./deploykit": {
      "types": "./dist/deploykit.d.ts",
      "default": "./dist/deploykit.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PolariseLabs/deploykit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/PolariseLabs/deploykit#readme",
  "bugs": {
    "url": "https://github.com/PolariseLabs/deploykit/issues"
  }
}
