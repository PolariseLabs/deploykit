{
  "name": "@deploykit/vercel",
  "version": "0.1.0-alpha.1",
  "description": "Vercel adapter for DeployKit.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./control": {
      "types": "./dist/control.d.ts",
      "default": "./dist/control.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@deploykit/core": "workspace:*",
    "effect": "4.0.0-rc.112"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
