{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "types": ["node"]
  },
  "include": ["packages/*/tests/**/*.ts", "vitest.config.ts", "eslint.config.js", "scripts/**/*.ts"]
}
